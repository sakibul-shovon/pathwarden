# Pathwarden local configuration. Copy to `.env` (gitignored). NEVER commit `.env`.
# Scripted mode, `make test` and the deterministic `make eval` need NONE of the LLM variables (plan §4 rule 10).
#
# Names marked [plan] appear in plan.md. Names marked [proposed] are NOT in the plan:
# confirm them in P0 and record the final names in docs/DECISIONS.md (A-13).

# --- API ---
PW_STATE_DIR=state               # [proposed] where events/verdicts/sink files are written
PW_AUTH=off                      # [plan §17] `off` for local mode; hosted mode uses API keys

# --- FalkorDB ---
PW_FALKORDB_HOST=localhost       # [proposed]
PW_FALKORDB_PORT=6379            # [plan §6: DB port 6379]
PW_FALKORDB_PASSWORD=            # [proposed] leave empty for local Docker; set for hosted

# --- Live LLM mode, LLM judges, LLM forensic mode (P8) ---
PW_LLM_MODEL=                    # [plan §12.3] LiteLLM model string. Provider chosen: Groq → `groq/<model>` (confirm in the P8 probe)
PW_LLM_API_KEY=                  # [plan §12.3] REAL SECRET. Only ever in your local .env
PW_LLM_TEMPERATURE=0             # [plan §12.3] default 0

# --- MCP gateway identity (P9). Set per gateway process, not globally: ---
# PW_WORKSPACE=tinyqueue
# PW_AGENT_ID=triage
# PW_DAY_LABEL=Mon
# PW_TASK_REF=issue:42

# --- Frontend (put in web/.env, also gitignored) ---
# VITE_API_BASE=http://localhost:8000    # [plan §23] port 8000 is an ASSUMPTION (Uvicorn default)
