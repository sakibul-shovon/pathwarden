{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git push origin phase/*)",
      "Bash(git push -u origin phase/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(make test *)",
      "Bash(make lint *)",
      "Bash(make fmt *)",
      "Bash(make probe *)",
      "Bash(make demo *)",
      "Bash(make eval)",
      "Bash(sh scripts/scan_secrets.sh*)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git push origin phase/*)",
      "PowerShell(git push -u origin phase/*)",
      "PowerShell(git push origin fix/*)",
      "PowerShell(git push -u origin fix/*)",
      "PowerShell(git push origin docs/*)",
      "PowerShell(git push -u origin docs/*)",
      "PowerShell(make test *)",
      "PowerShell(make lint *)",
      "PowerShell(make probe *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(make eval-live *)",
      "Bash(docker compose down *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git tag *)",
      "PowerShell(make eval-live *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(git update-ref *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git * --no-verify*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git branch -D *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./web/.env)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./web/.env)"
    ]
  }
}
