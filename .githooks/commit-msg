#!/usr/bin/env sh
# Pathwarden commit-msg: enforces  P<n>[a-d]: <type>(<scope>): <summary>
#   P3: feat(api): add scenario runner
#   P10a: fix: cytoscape edge colours
# Types: feat fix test refactor docs chore ci perf.  Merge/Revert commits are exempt.
set -eu

first=$(head -n 1 "$1")

case "$first" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

if printf '%s' "$first" | grep -Eq '^P([0-9]|1[0-2])[a-d]?: (feat|fix|test|refactor|docs|chore|ci|perf)(\([a-z0-9_.-]+\))?: .{3,}$'; then
  exit 0
fi

echo "commit-msg: bad first line:" >&2
echo "  $first" >&2
echo "expected: P<n>[a-d]: <type>(<scope>): <summary>   e.g.  P3: feat(api): add scenario runner" >&2
echo "types: feat fix test refactor docs chore ci perf" >&2
exit 1
